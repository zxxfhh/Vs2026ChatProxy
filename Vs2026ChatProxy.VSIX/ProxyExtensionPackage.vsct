<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidProxyExtensionPackage">
    <Buttons>
      <Button guid="guidProxyExtensionCmdSet" id="cmdidShowMainWindow" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1"/>
        <Icon guid="guidImages" id="bmpIcon" />
        <Strings>
          <ButtonText>VsCopilotProxy</ButtonText>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidImages" href="app.ico" usedList="bmpIcon"/>
    </Bitmaps>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidProxyExtensionPackage" value="{c3d4e5f6-a7b8-9012-cdef-123456789012}" />
    <GuidSymbol name="guidProxyExtensionCmdSet" value="{d4e5f6a7-b8c9-0123-def4-567890123456}">
      <IDSymbol name="cmdidShowMainWindow" value="0x2000"/>
    </GuidSymbol>
    <GuidSymbol name="guidImages" value="{e5f6a7b8-c9d0-1234-ef56-789012345678}">
      <IDSymbol name="bmpIcon" value="1" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
