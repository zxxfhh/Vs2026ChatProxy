{
  "name": "vs2026-chat-proxy",
  "displayName": "VsChatProxy — 自定义模型代理",
  "description": "内置代理程序，装完即用：状态栏启停、代理窗口配置供应商、把代理的模型一键写入 VS Code 聊天模型（Custom Endpoint）",
  "version": "1.1.6",
  "publisher": "zxxfhh",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zxxfhh/Vs2026ChatProxy.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vschatproxy.toggle",
        "title": "启动/停止代理",
        "category": "VsChatProxy"
      },
      {
        "command": "vschatproxy.openWindow",
        "title": "打开代理窗口（配置供应商）",
        "category": "VsChatProxy"
      },
      {
        "command": "vschatproxy.configureChatModels",
        "title": "把代理的模型写入 VS Code 聊天模型",
        "category": "VsChatProxy"
      },
      {
        "command": "vschatproxy.showModels",
        "title": "查看模型列表",
        "category": "VsChatProxy"
      },
      {
        "command": "vschatproxy.refreshModels",
        "title": "刷新模型列表",
        "category": "VsChatProxy",
        "icon": "$(refresh)"
      },
      {
        "command": "vschatproxy.openConfig",
        "title": "打开配置文件",
        "category": "VsChatProxy"
      },
      {
        "command": "vschatproxy.checkUpdate",
        "title": "检查更新",
        "category": "VsChatProxy"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vschatproxy",
          "title": "VsChatProxy",
          "icon": "$(plug)"
        }
      ]
    },
    "views": {
      "vschatproxy": [
        {
          "id": "vschatproxy.models",
          "name": "模型列表"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vschatproxy.models",
        "contents": "代理没在运行。\n[启动/停止代理](command:vschatproxy.toggle) · [打开代理窗口配置供应商](command:vschatproxy.openWindow)\n模型要出现在 Chat 的模型选择器里，还需执行「把模型写入 VS Code 聊天模型」。"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vschatproxy.refreshModels",
          "when": "view == vschatproxy.models",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VsChatProxy",
      "properties": {
        "vschatproxy.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "代理服务地址（不含 /v1 后缀）。启动时会自动与代理配置文件里的端口保持一致"
        },
        "vschatproxy.configPath": {
          "type": "string",
          "default": "",
          "description": "代理配置文件（proxy-config.json）路径。留空时用插件自己的配置（代理窗口里添加的供应商保存在这里，路径见状态栏悬停提示或输出面板 VsChatProxy）。VS 2026 插件用的是另一份，想两边共用就把它指过去"
        },
        "vschatproxy.executablePath": {
          "type": "string",
          "default": "",
          "description": "可选：改用自己编译或别处的 Vs2026ChatProxy.exe。留空则使用插件内置的代理程序"
        },
        "vschatproxy.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "VS Code 启动时代理未运行则自动后台拉起（配置里已有供应商时）"
        },
        "vschatproxy.maxOutputTokens": {
          "type": "number",
          "default": 8192,
          "minimum": 256,
          "description": "写入 VS Code 模型配置的最大输出 token 数。VS Code 会把它作为 max_tokens 发给代理，8192 是各家兼容接口都接受的上限"
        },
        "vschatproxy.maxInputTokens": {
          "type": "number",
          "default": 128000,
          "minimum": 4096,
          "description": "代理没有广播模型上下文长度时，写入 VS Code 模型配置的最大输入 token 数"
        },
        "vschatproxy.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "启动时检查 GitHub Releases 的新版本并提示更新"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run proxy:sync",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "proxy:sync": "node scripts/sync-proxy.js",
    "package": "npx vsce package --allow-missing-repository --out VsCodeCopilotProxy.vsix",
    "test": "node --test test/proxyInfo.test.js test/chatProvider.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
